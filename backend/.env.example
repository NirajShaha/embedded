ENVIRONMENT="development"

DATABASE_URL="mysql://application_user:replace-with-password@localhost:3306/embedded_db"

CORS_ORIGINS=["http://localhost:3000"]

JWT_SECRET_KEY="replace-with-a-random-secret-of-at-least-32-characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

SEED_DEFAULT_USERS=true

INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="replace-with-a-secure-admin-password"

INITIAL_USER_USERNAME="user"
INITIAL_USER_PASSWORD="replace-with-a-secure-user-password"