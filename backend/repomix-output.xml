def _esc(value: object) -> str:
    if value is None:
        return ""
    return (
        str(value)
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
    )


def _fmt_date(value: date | None) -> str:
    return value.strftime("%d/%m/%Y") if value else "\u2014"


