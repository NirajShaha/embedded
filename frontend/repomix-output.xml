  --sidebar-accent-foreground: oklch(0.22 0.015 250);
  --sidebar-border: oklch(0.92 0.005 240);
  --sidebar-ring: oklch(0.62 0.13 215);
}

/* ============================================================
 * DARK MODE — the home register. Deep ink with cyan glow.
 * Designed to feel like a security operations console.
 * ============================================================ */
.dark {
  --background: oklch(0.16 0.012 250);
  --foreground: oklch(0.96 0.005 240);

