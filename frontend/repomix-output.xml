  --radius: 0.625rem;

  --sidebar: oklch(0.99 0.003 240);
  --sidebar-foreground: oklch(0.22 0.015 250);
  --sidebar-primary: oklch(0.32 0.045 250);
  --sidebar-primary-foreground: oklch(0.985 0.003 240);
