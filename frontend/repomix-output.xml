        >
          <ScrollArea className="min-h-0 flex-1">
            <div className="space-y-6 p-6">
              <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3">
                <FormField id="ecu_name" label="ECU name" required>
                  <Input
                    id="ecu_name"
