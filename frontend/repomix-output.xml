  --border: oklch(0.92 0.005 240);
  --input: oklch(0.92 0.005 240);
  --ring: oklch(0.62 0.13 215);

  /* Charts ordered by semantic severity rank. */
  --chart-1: oklch(0.62 0.18 215);   /* signal cyan — primary */
  --chart-2: oklch(0.58 0.15 250);   /* ink blue */
  --chart-3: oklch(0.65 0.14 175);   /* teal */
  --chart-4: oklch(0.7 0.14 75);     /* amber */
