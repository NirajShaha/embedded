@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  html {
    @apply font-sans;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }
  body {
    @apply bg-background text-foreground;
    font-feature-settings: "ss01", "cv11";
  }
  /* Heading lockup — every heading uses the same family with optical sizing. */
  h1, h2, h3, h4 {
    @apply font-heading tracking-tight text-foreground;
  }
  /* Mono numerals in tables keep numbers aligned across rows. */
  .font-tabular {
    font-variant-numeric: tabular-nums;
  }
}

@layer utilities {
  /* Subtle scanline-inspired grain for surfaces. */
  .surface-grain {
    background-image:
      radial-gradient(ellipse at top, oklch(0.62 0.13 215 / 0.04), transparent 60%),
      linear-gradient(180deg, oklch(0.16 0.012 250 / 0), oklch(0.16 0.012 250 / 0.02));
  }
  .dark .surface-grain {
    background-image:
      radial-gradient(ellipse at top, oklch(0.78 0.14 215 / 0.07), transparent 60%),
      linear-gradient(180deg, oklch(0.16 0.012 250 / 0), oklch(0.16 0.012 250 / 0.4));
  }
  /* Focus ring tuned to brand and visible on both registers. */
  .ring-focus {
    @apply outline-none ring-2 ring-ring/70 ring-offset-2 ring-offset-background;
  }
  /* Staggered fade-in for grouped items. */
  .stagger-in > * {
    animation: stagger-in 0.4s ease-out both;
  }
  .stagger-in > *:nth-child(1) { animation-delay: 30ms; }
  .stagger-in > *:nth-child(2) { animation-delay: 70ms; }
  .stagger-in > *:nth-child(3) { animation-delay: 110ms; }
  .stagger-in > *:nth-child(4) { animation-delay: 150ms; }
  .stagger-in > *:nth-child(5) { animation-delay: 190ms; }
  .stagger-in > *:nth-child(6) { animation-delay: 230ms; }
  .stagger-in > *:nth-child(7) { animation-delay: 270ms; }
  .stagger-in > *:nth-child(8) { animation-delay: 310ms; }

  @keyframes stagger-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stagger-in > * {
      animation: none !important;
    }
  }
}
