"use client";

import * as React from "react";


const MOBILE_BREAKPOINT = 768;


function getIsMobile(): boolean {
  if (typeof window === "undefined") {
    return false;
  }

  return (
    window.innerWidth <
    MOBILE_BREAKPOINT
  );
}


export function useIsMobile() {
  const [
    isMobile,
    setIsMobile,
  ] = React.useState<boolean>(
    getIsMobile,
  );

  React.useEffect(() => {
    const mediaQuery =
      window.matchMedia(
        `(max-width: ${MOBILE_BREAKPOINT - 1
        }px)`,
      );

    const onChange = () => {
      setIsMobile(
        window.innerWidth <
        MOBILE_BREAKPOINT,
      );
    };

    mediaQuery.addEventListener(
      "change",
      onChange,
    );

    return () => {
      mediaQuery.removeEventListener(
        "change",
        onChange,
      );
    };
  }, []);

  return isMobile;
}
