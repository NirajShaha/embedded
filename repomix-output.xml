@import "tailwindcss";
@import "tw-animate-css";
@import "shadcn/tailwind.css";

@custom-variant dark (&:is(.dark *));

/* ---------- Brand direction ----------
 * Embedded security tooling for automotive ECUs.
 * Domain cue: signal/wire, oscilloscope, terminal cyan, fault-flag amber.
 * We pick a deep ink canvas with a single saturated cyan as the protagonist.
 * The chart palette uses severity-coded hues with deliberate lightness gaps
 * so the eye can rank them in a glance, not decode them.
 * ----------------------------------- */

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);

  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
  --font-heading: var(--font-geist-sans);

  --color-sidebar-ring: var(--sidebar-ring);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar: var(--sidebar);

  --color-chart-5: var(--chart-5);
  --color-chart-4: var(--chart-4);
  --color-chart-3: var(--chart-3);
  --color-chart-2: var(--chart-2);
  --color-chart-1: var(--chart-1);

  --color-ring: var(--ring);
  --color-input: var(--input);
  --color-border: var(--border);

  --color-destructive: var(--destructive);

  --color-accent-foreground: var(--accent-foreground);
  --color-accent: var(--accent);

  --color-muted-foreground: var(--muted-foreground);
  --color-muted: var(--muted);

  --color-secondary-foreground: var(--secondary-foreground);
  --color-secondary: var(--secondary);

  --color-primary-foreground: var(--primary-foreground);
  --color-primary: var(--primary);

  --color-popover-foreground: var(--popover-foreground);
  --color-popover: var(--popover);

  --color-card-foreground: var(--card-foreground);
  --color-card: var(--card);

  /* Severity tokens — used by badges, row accents, and chart roles. */
  --color-severity-critical: var(--severity-critical);
  --color-severity-high: var(--severity-high);
  --color-severity-medium: var(--severity-medium);
  --color-severity-low: var(--severity-low);
  --color-severity-info: var(--severity-info);

  /* Domain accent (cyan) — used sparingly to mean "live signal". */
  --color-signal: var(--signal);
  --color-signal-foreground: var(--signal-foreground);

  --radius-sm: calc(var(--radius) * 0.5);
  --radius-md: calc(var(--radius) * 0.75);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) * 1.5);
  --radius-2xl: calc(var(--radius) * 2);
  --radius-3xl: calc(var(--radius) * 2.6);
  --radius-4xl: calc(var(--radius) * 3.2);

  /* Type scale (Major Third tuned, 1.250). */
  --text-xs: 0.75rem;
  --text-xs--line-height: 1.4;
  --text-sm: 0.875rem;
  --text-sm--line-height: 1.5;
  --text-base: 0.9375rem;
  --text-base--line-height: 1.6;
  --text-md: 1.0625rem;
  --text-md--line-height: 1.55;
  --text-lg: 1.1875rem;
  --text-lg--line-height: 1.5;
  --text-xl: 1.375rem;
  --text-xl--line-height: 1.4;
  --text-2xl: 1.625rem;
  --text-2xl--line-height: 1.3;
  --text-3xl: 2rem;
  --text-3xl--line-height: 1.2;
}

/* ============================================================
 * LIGHT MODE — ink-tinted neutrals, cyan protagonist.
 * Neutrals carry a tiny blue chroma so they read as authored.
 * ============================================================ */
:root {
  --background: oklch(0.985 0.003 240);
  --foreground: oklch(0.18 0.012 250);

  --card: oklch(1 0 0);
  --card-foreground: oklch(0.18 0.012 250);

  --popover: oklch(1 0 0);
  --popover-foreground: oklch(0.18 0.012 250);

  --primary: oklch(0.32 0.045 250);
  --primary-foreground: oklch(0.985 0.003 240);

  --secondary: oklch(0.965 0.005 240);
  --secondary-foreground: oklch(0.24 0.015 250);

  --muted: oklch(0.965 0.005 240);
  --muted-foreground: oklch(0.5 0.015 250);

  --accent: oklch(0.96 0.012 230);
  --accent-foreground: oklch(0.24 0.015 250);

  --destructive: oklch(0.55 0.21 27);
  --destructive-foreground: oklch(0.99 0.005 27);

  --border: oklch(0.92 0.005 240);
  --input: oklch(0.92 0.005 240);
  --ring: oklch(0.62 0.13 215);

  /* Charts ordered by semantic severity rank. */
  --chart-1: oklch(0.62 0.18 215);   /* signal cyan — primary */
  --chart-2: oklch(0.58 0.15 250);   /* ink blue */
  --chart-3: oklch(0.65 0.14 175);   /* teal */
  --chart-4: oklch(0.7 0.14 75);     /* amber */
  --chart-5: oklch(0.58 0.2 30);     /* fault red */

  --severity-critical: oklch(0.55 0.21 27);
  --severity-high:     oklch(0.65 0.18 45);
  --severity-medium:   oklch(0.7 0.16 75);
  --severity-low:      oklch(0.62 0.13 165);
  --severity-info:     oklch(0.6 0.08 250);

  --signal: oklch(0.62 0.13 215);
  --signal-foreground: oklch(0.985 0.003 240);

  --radius: 0.625rem;

  --sidebar: oklch(0.99 0.003 240);
  --sidebar-foreground: oklch(0.22 0.015 250);
  --sidebar-primary: oklch(0.32 0.045 250);
  --sidebar-primary-foreground: oklch(0.985 0.003 240);
  --sidebar-accent: oklch(0.95 0.012 230);
  --sidebar-accent-foreground: oklch(0.22 0.015 250);
  --sidebar-border: oklch(0.92 0.005 240);
  --sidebar-ring: oklch(0.62 0.13 215);
}

/* ============================================================
 * DARK MODE — the home register. Deep ink with cyan glow.
 * Designed to feel like a security operations console.
 * ============================================================ */
.dark {
  --background: oklch(0.16 0.012 250);
  --foreground: oklch(0.96 0.005 240);

  --card: oklch(0.2 0.012 250);
  --card-foreground: oklch(0.96 0.005 240);

  --popover: oklch(0.21 0.012 250);
  --popover-foreground: oklch(0.96 0.005 240);

  --primary: oklch(0.78 0.14 215);
  --primary-foreground: oklch(0.16 0.012 250);

  --secondary: oklch(0.25 0.012 250);
  --secondary-foreground: oklch(0.96 0.005 240);

  --muted: oklch(0.24 0.012 250);
  --muted-foreground: oklch(0.66 0.015 240);

  --accent: oklch(0.27 0.02 220);
  --accent-foreground: oklch(0.96 0.005 240);

  --destructive: oklch(0.68 0.2 27);
  --destructive-foreground: oklch(0.16 0.012 250);

  --border: oklch(0.28 0.01 250);
  --input: oklch(0.28 0.01 250);
  --ring: oklch(0.72 0.14 215);

  --chart-1: oklch(0.78 0.15 215);
  --chart-2: oklch(0.7 0.13 250);
  --chart-3: oklch(0.75 0.12 175);
  --chart-4: oklch(0.78 0.15 75);
  --chart-5: oklch(0.7 0.19 30);

  --severity-critical: oklch(0.7 0.2 27);
  --severity-high:     oklch(0.78 0.17 45);
  --severity-medium:   oklch(0.82 0.15 75);
  --severity-low:      oklch(0.78 0.12 165);
  --severity-info:     oklch(0.7 0.08 250);

  --signal: oklch(0.78 0.14 215);
  --signal-foreground: oklch(0.16 0.012 250);

  --sidebar: oklch(0.18 0.012 250);
  --sidebar-foreground: oklch(0.94 0.005 240);
  --sidebar-primary: oklch(0.78 0.14 215);
  --sidebar-primary-foreground: oklch(0.16 0.012 250);
  --sidebar-accent: oklch(0.24 0.015 220);
  --sidebar-accent-foreground: oklch(0.96 0.005 240);
  --sidebar-border: oklch(0.26 0.01 250);
  --sidebar-ring: oklch(0.72 0.14 215);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  html {
    @apply font-sans;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }
  body {
    @apply bg-background text-foreground;
    font-feature-settings: "ss01", "cv11";
  }
  /* Heading lockup — every heading uses the same family with optical sizing. */
  h1, h2, h3, h4 {
    @apply font-heading tracking-tight text-foreground;
  }
  /* Mono numerals in tables keep numbers aligned across rows. */
  .font-tabular {
    font-variant-numeric: tabular-nums;
  }
}

@layer utilities {
  /* Subtle scanline-inspired grain for surfaces. */
  .surface-grain {
    background-image:
      radial-gradient(ellipse at top, oklch(0.62 0.13 215 / 0.04), transparent 60%),
      linear-gradient(180deg, oklch(0.16 0.012 250 / 0), oklch(0.16 0.012 250 / 0.02));
  }
  .dark .surface-grain {
    background-image:
      radial-gradient(ellipse at top, oklch(0.78 0.14 215 / 0.07), transparent 60%),
      linear-gradient(180deg, oklch(0.16 0.012 250 / 0), oklch(0.16 0.012 250 / 0.4));
  }
  /* Focus ring tuned to brand and visible on both registers. */
  .ring-focus {
    @apply outline-none ring-2 ring-ring/70 ring-offset-2 ring-offset-background;
  }
  /* Staggered fade-in for grouped items. */
  .stagger-in > * {
    animation: stagger-in 0.4s ease-out both;
  }
  .stagger-in > *:nth-child(1) { animation-delay: 30ms; }
  .stagger-in > *:nth-child(2) { animation-delay: 70ms; }
  .stagger-in > *:nth-child(3) { animation-delay: 110ms; }
  .stagger-in > *:nth-child(4) { animation-delay: 150ms; }
  .stagger-in > *:nth-child(5) { animation-delay: 190ms; }
  .stagger-in > *:nth-child(6) { animation-delay: 230ms; }
  .stagger-in > *:nth-child(7) { animation-delay: 270ms; }
  .stagger-in > *:nth-child(8) { animation-delay: 310ms; }

  @keyframes stagger-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stagger-in > * {
      animation: none !important;
    }
  }
}
